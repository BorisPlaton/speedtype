# Used by MongoDB container
MONGO_INITDB_ROOT_USERNAME=dev
MONGO_INITDB_ROOT_PASSWORD=devdev
MONGO_INITDB_DATABASE=zeus

ZEUS_APP_NAME=Zeus
ZEUS_LOG_LEVEL=INFO
ZEUS_PORT=3550
ZEUS_DEBUG=True

MONGO_HOST=mongodb
MONGO_PORT=3551
MONGO_USERNAME="${MONGO_INITDB_ROOT_USERNAME}"
MONGO_PASSWORD="${MONGO_INITDB_ROOT_PASSWORD}"
MONGO_DATABASE_NAME="${MONGO_INITDB_DATABASE}"
