# Used by MongoDB container
MONGODB_INITDB_ROOT_USERNAME=dev
MONGODB_INITDB_ROOT_PASSWORD=devdev
MONGODB_INITDB_DATABASE=zeus

ZEUS_APP_NAME=Zeus
ZEUS_LOG_LEVEL=INFO
ZEUS_PORT=3550
ZEUS_DEBUG=True

MONGODB_HOST=mongodb
MONGODB_PORT=3551
MONGODB_USERNAME="${MONGODB_INITDB_ROOT_USERNAME}"
MONGODB_PASSWORD="${MONGODB_INITDB_ROOT_PASSWORD}"
MONGODB_DATABASE_NAME="${MONGODB_INITDB_DATABASE}"
